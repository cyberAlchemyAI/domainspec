{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domainspec.subagent-strategy-registration-envelope.v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "profile_ref",
    "ledger",
    "source_sheet_ref",
    "source_lifecycle",
    "confirmation",
    "admission_receipt_ref",
    "execution_projection_sha256",
    "temporary_close",
    "registration_record"
  ],
  "properties": {
    "schema_version": {
      "const": "domainspec.subagent-strategy-registration-envelope.v1"
    },
    "profile_id": {
      "const": "domainspec.subagent-strategy.private.v1"
    },
    "profile_ref": { "$ref": "#/$defs/exactRef" },
    "ledger": {
      "const": "telemetry/agents/subagents-dispatch.yaml"
    },
    "source_sheet_ref": { "$ref": "#/$defs/exactRef" },
    "source_lifecycle": { "const": "durable" },
    "confirmation": {
      "type": "object",
      "required": [
        "mode",
        "handle",
        "binding_sha256",
        "material_equivalence_ref"
      ],
      "properties": {
        "mode": { "const": "material_projection" },
        "handle": { "type": "string", "minLength": 1 },
        "binding_sha256": { "$ref": "#/$defs/sha256" },
        "material_equivalence_ref": {
          "anyOf": [{ "$ref": "#/$defs/exactRef" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "admission_receipt_ref": { "$ref": "#/$defs/exactRef" },
    "execution_projection_sha256": { "$ref": "#/$defs/sha256" },
    "temporary_close": {
      "type": "string",
      "pattern": "^telemetry/agents/runtime/subagents-strategy/[A-Za-z0-9._-]+\\.close\\.tmp\\.json$"
    },
    "registration_record": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exactRef": {
      "type": "object",
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
