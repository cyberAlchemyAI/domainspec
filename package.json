{
  "name": "domainspec-runtime-workspace",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "backend",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "code-tags:extract": "pnpm dlx tsx governance/tags/tools/extract-code-tags.ts --output governance/tags/code-tags.json --mode strict",
    "code-tags:validate": "pnpm dlx tsx governance/tags/tools/validate-code-tags.ts --input governance/tags/code-tags.json --waivers governance/tags/code-tag-waivers.yaml --mode strict",
    "code-tags:composability": "pnpm dlx tsx governance/tags/tools/check-code-tag-composability.ts --input governance/tags/code-tags.json --mode strict",
    "code-tags:drift": "pnpm dlx tsx governance/tags/tools/compare-code-tag-drift.ts --input governance/tags/code-tags.json --mode strict --report governance/tags/CODE-TAG-DRIFT-REPORT.md",
    "code-tags:test": "pnpm dlx tsx --test governance/tags/tools/tests/*.test.ts",
    "check:code-tags": "pnpm run code-tags:extract && pnpm run code-tags:validate && pnpm run code-tags:composability && pnpm run code-tags:drift",
    "governance:attenuation:audit": "pnpm dlx tsx tools/governance-attenuation-audit.ts",
    "dev": "pnpm -r --parallel dev",
    "dev:local": "pnpm -r --parallel dev",
    "dev:local:poker-docs": "KG_DOCS_IMPORT_PATH=$(pwd)/../../validation/poker-team/docs/features pnpm -r --parallel dev",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:logs": "docker compose -f infra/docker-compose.dev.yml logs -f postgres",
    "dev:backend": "pnpm --filter @domainspec/backend dev",
    "dev:web": "pnpm --filter @domainspec/web dev"
  }
}
