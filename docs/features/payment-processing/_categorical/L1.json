  "objects": [
    {
      "id": "payment.PaymentTransaction",
      "meta_type": "Entity",
      "anchor": "docs/features/payment-processing/domain.md#paymenttransaction",
      "fields": [
        { "name": "id", "type_ref": "TransactionId", "required": true },
        { "name": "amount", "type_ref": "shared.Money", "required": true },
        { "name": "fee", "type_ref": "shared.Money", "required": true },
        { "name": "totalCharged", "type_ref": "shared.Money", "required": true },
        { "name": "method", "type_ref": "payment.PaymentMethod", "required": true },
        { "name": "status", "type_ref": "payment.PaymentStatus", "required": true },
        { "name": "orderId", "type_ref": "OrderId", "required": true },
        { "name": "userId", "type_ref": "UserId", "required": true },
        { "name": "gatewayRef", "type_ref": "string", "required": false },
        { "name": "retryCount", "type_ref": "integer", "required": true },
        { "name": "refundedAmount", "type_ref": "shared.Money", "required": false },
        { "name": "createdAt", "type_ref": "DateTime", "required": true },
        { "name": "updatedAt", "type_ref": "DateTime", "required": true }
      ],
      "invariants": [
        "status == Completed -> gatewayRef != null",
        "refundedAmount <= amount",
        "retryCount <= maxRetries",
        "status in {Failed, Refunded, RefundFailed} -> no transitions",
        "status != Created -> fee != null",
        "createdAt is immutable across transitions"
      ]
    },
    {
      "id": "shared.Money",
      "meta_type": "ValueObject",
      "anchor": "docs/shared/money.md#money",
      "external": true,
      "fields": [
        { "name": "amount", "type_ref": "Decimal", "required": true },
        { "name": "currency", "type_ref": "CurrencyCode", "required": true }
      ],
      "invariants": [
        "amount > 0",
        "amount has max 2 decimal places",
        "currency is ISO 4217"
      ]
    },
    {
      "id": "payment.PaymentMethod",
      "meta_type": "Enum",
      "anchor": "docs/features/payment-processing/domain.md#paymentmethod",
      "values": ["CREDIT_CARD", "BANK_TRANSFER", "WALLET"]
    },
    {
      "id": "payment.PaymentStatus",
      "meta_type": "StateMachine",
      "anchor": "docs/features/payment-processing/states.md#paymentstatus",
      "states": [
        { "name": "Created", "terminal": false },
        { "name": "Processing", "terminal": false },
        { "name": "Completed", "terminal": false },
        { "name": "Failed", "terminal": true },
        { "name": "FailedRetryable", "terminal": false },
        { "name": "Refunding", "terminal": false },
        { "name": "Refunded", "terminal": true },
        { "name": "RefundFailed", "terminal": true }
      ],
      "invariants": [
        "I1: status == Completed -> gatewayRef != null",
        "I2: refundedAmount <= amount",
        "I3: retryCount <= maxRetries",
        "I4: status in {Failed, Refunded, RefundFailed} -> no transitions",
        "I5: status != Created -> fee != null",
        "I6: createdAt is immutable"
      ]
    },
    {
      "id": "payment.ProcessPayment",
      "meta_type": "Operation",
      "anchor": "docs/features/payment-processing/operations.md#processpayment",
      "actor": "Authenticated User",
      "rules_inline": ["R1", "R2", "R3", "R4", "R5"],
      "calculations_inline": ["C1", "C2"],
      "state_transition": "PaymentTransaction: [new] -> Created -> Processing"
    },
    {
      "id": "payment.RefundPayment",
      "meta_type": "Operation",
      "anchor": "docs/features/payment-processing/operations.md#refundpayment",
      "actor": "Admin or System",
      "rules_inline": ["R6", "R7", "R8"],
      "calculations_inline": ["C3"],
      "state_transition": "PaymentTransaction: Completed -> Refunding"
    },
    {
      "id": "payment.RetryPayment",
      "meta_type": "Operation",
      "anchor": "docs/features/payment-processing/operations.md#retrypayment",
      "actor": "System",
      "rules_inline": ["R9", "R10"],
      "state_transition": "PaymentTransaction: FailedRetryable -> Processing"
    },
    {
      "id": "payment.FeeCalculation",
      "meta_type": "Calculation",
      "anchor": "docs/features/payment-processing/operations.md#feecalculation",
      "formula": "fee = max(amount * rate(method), minimumFee(method))",
      "properties": [
        "fee >= 0",
        "fee <= amount",
        "deterministic"
      ]
    },
    {
      "id": "payment.MaxAmountRule",
      "meta_type": "Rule",
      "anchor": "docs/features/payment-processing/operations.md#processpayment",
      "formal": "amount.value <= 10000"
    },
    {
      "id": "payment.MethodAvailabilityRule",
      "meta_type": "Rule",
      "anchor": "docs/features/payment-processing/operations.md#processpayment",
      "formal": "method in enabledMethods(user.country)"
    },
